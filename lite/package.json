{
  "name": "mdhtml-lite",
  "version": "0.1.0",
  "description": "Small streaming md previews, with mdhtml as the authoritative final renderer",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1"
    }
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "*.js",
    "index.d.ts",
    "README.md",
    "dialect-mini.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnswerDotAI/mdhtml.git",
    "directory": "lite"
  },
  "keywords": [
    "markdown",
    "streaming",
    "mdhtml",
    "llm"
  ],
  "scripts": {
    "test:watch": "vp test watch",
    "dev": "node scripts/dev.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "linkedom": "^0.18.15",
    "vite-plus": "1.7.0"
  }
}
